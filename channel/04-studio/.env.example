# Copy to .env (never commit .env). Fill only the provider you use.
VOICE_PROVIDER=elevenlabs

# ElevenLabs (best Saudi-dialect quality). Voice ID: pick a Saudi/Khaleeji voice in the Voice Library,
# or your own cloned voice. Model: eleven_multilingual_v2 (stable) or eleven_v3 (more expressive).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Google Cloud Text-to-Speech (generous free tier, Modern Standard Arabic accent)
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=ar-XA-Chirp3-HD-Charon

# Amazon Polly Gulf Arabic neural voices (Zayd = male, Hala = female). Uses your AWS CLI login.
POLLY_VOICE=Zayd

# Free test voice (pip install edge-tts). Not for monetized videos.
EDGE_VOICE=ar-SA-HamedNeural
EDGE_RATE=-5%

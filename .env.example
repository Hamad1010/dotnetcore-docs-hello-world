# Copy this file to `.env` and fill in your own Supabase project values.
# Find these at supabase.com/dashboard -> your project -> Settings -> API.
# The anon key is safe to use in the app (it's protected by Row Level
# Security rules in supabase/schema.sql), but never commit your `.env` file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
